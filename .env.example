CLAUDE_MODEL_CHAT=claude-sonnet-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_JUDGE=claude-opus-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL_CODE=voyage-code-3
VOYAGE_MODEL_TEXT=voyage-3.5
VOYAGE_MODEL_RERANK=rerank-2.5

# Auth
AUTH_SECRET=
AUTH_EMAIL_FROM=
SMTP_URL=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Connectors
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
